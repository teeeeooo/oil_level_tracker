#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
checker="$repo_root/scripts/check_detector_governance.py"
zero_sha="0000000000000000000000000000000000000000"
remote_name="${1:-origin}"
remote_main="refs/remotes/$remote_name/main"
checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "${local_sha:-}" ]] || continue
    [[ "$local_sha" == "$zero_sha" ]] && continue

    if [[ "${remote_sha:-}" == "$zero_sha" || -z "${remote_sha:-}" ]]; then
        if git show-ref --verify --quiet "$remote_main"; then
            base_ref="$(git merge-base "$local_sha" "$remote_main")"
        else
            base_ref="$(git rev-list --max-parents=0 "$local_sha" | tail -n 1)"
        fi
    else
        base_ref="$remote_sha"
    fi
    python3 "$checker" --base-ref "$base_ref" --head-ref "$local_sha"
    checked=1
done

if [[ "$checked" -eq 0 ]]; then
    printf 'S11 detector governance: no commit updates to check.\n'
fi
