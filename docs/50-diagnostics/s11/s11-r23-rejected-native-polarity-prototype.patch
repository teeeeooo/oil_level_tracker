+                    or track.identity in blocked_tracks
@@ -285,0 +306,7 @@ class DirectedInterfaceTrackletBuilder:
+                # Preserve the complete ambiguity graph. Removing a contrary
+                # edge earlier could manufacture a unique winner for a rival.
+                # A rejected chosen link starts fresh; no runner-up inherits it.
+                if self._native_path_opposition(track, hypothesis):
+                    blocked_predecessors[hypothesis.identity] = [track.identity]
+                    blocked_tracks.add(track.identity)
+                    continue
@@ -406,0 +434 @@ class DirectedInterfaceTrackletBuilder:
+                        tracklet_blocked_predecessors=tuple(blocked_predecessors.get(hypothesis.identity, ())),
@@ -555,0 +584,28 @@ class DirectedInterfaceTrackletBuilder:
+    def _native_path_opposition(
+        self, track: _TrackState, hypothesis: _RowHypothesis,
+    ) -> bool:
+        # This first R23 guard protects confirmation construction only. An
+        # already confirmed contour may change appearance (foam, lighting,
+        # visible sectors); polarity alone cannot revoke established identity.
+        if self._established(track):
+            return False
+        # A descriptor-free alias must not erase a recent contradictory path.
+        # Retention is bounded by the existing confirmation frame window.
+        if not any(m.evidence.native_path_polarities for m in hypothesis.members):
+            return False
+        earliest = hypothesis.frame_offset - self.policy.confirmation_window_frames + 1
+        for observation in reversed(track.observations):
+            prior = observation.hypothesis
+            if prior.frame_offset < earliest:
+                break
+            if not any(m.evidence.native_path_polarities for m in prior.members):
+                continue
+            # Polarity alone cannot distinguish adjacent edges of a bright
+            # boundary band. Only veto a positional reassociation outside the
+            # existing same-row tolerance, not a stationary contrast change.
+            if abs(hypothesis.y - prior.y) <= self.policy.row_hypothesis_tolerance_px:
+                return False
+            return any(_opposed_native_paths(current, previous)
+                       for current in hypothesis.members for previous in prior.members)
+        return False
+
