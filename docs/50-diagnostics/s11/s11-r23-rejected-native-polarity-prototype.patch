diff --git a/src/oil_tracker/adapters/vision/oil_candidate_evidence.py b/src/oil_tracker/adapters/vision/oil_candidate_evidence.py
index 19944f6..334ff0e 100644
--- a/src/oil_tracker/adapters/vision/oil_candidate_evidence.py
+++ b/src/oil_tracker/adapters/vision/oil_candidate_evidence.py
@@ -3,0 +4 @@ from dataclasses import dataclass
+import math
@@ -31,0 +33,29 @@ class EvidenceAvailability:
+@dataclass(frozen=True)
+class NativePathPolarity:
+    """Comparable generator gray contrasts, not independent Oil evidence."""
+
+    start_x: int
+    stop_x: int
+    signed_contrast: float
+
+
+def _native_path_polarities(candidate: BoundaryCandidate) -> tuple[NativePathPolarity, ...]:
+    if not any(f"native_path_{sector}_start_x" in candidate.features for sector in range(5)):
+        return ()
+    samples = []
+    for sector in range(5):
+        if candidate.features.get(f"native_path_{sector}_contrast_channel") != 1.0:
+            continue
+        values = tuple(candidate.features.get(f"native_path_{sector}_{name}")
+                       for name in ("start_x", "stop_x", "signed_contrast"))
+        if any(not isinstance(v, (float, int)) or not math.isfinite(v) for v in values):
+            continue
+        start, stop, contrast = values
+        # The generator already requires >= .025 signed support per path point.
+        # Material-channel winners and missing/invalid samples are unavailable.
+        if start < 0 or stop <= start or int(start) != start or int(stop) != stop or abs(contrast) < 0.025:
+            continue
+        samples.append(NativePathPolarity(int(start), int(stop), float(contrast)))
+    return tuple(samples)
+
+
@@ -60,0 +91 @@ class OilCandidateEvidence:
+    native_path_polarities: tuple[NativePathPolarity, ...] = ()
@@ -222,0 +254 @@ class OilCandidateEvidence:
+            native_path_polarities=_native_path_polarities(candidate),
diff --git a/src/oil_tracker/adapters/vision/oil_interface_tracklets.py b/src/oil_tracker/adapters/vision/oil_interface_tracklets.py
index 7a01a6a..51398dc 100644
--- a/src/oil_tracker/adapters/vision/oil_interface_tracklets.py
+++ b/src/oil_tracker/adapters/vision/oil_interface_tracklets.py
@@ -192,0 +193,16 @@ _AssignmentPair = tuple[float, str, str, _TrackState, _RowHypothesis]
+def _opposed_native_paths(first: OilCandidateRef, second: OilCandidateRef) -> bool:
+    """Negative association evidence only; agreement never grants authority.
+
+    Match exact native X extents in the same ROI, not sector ordinals, candidate
+    medians or diagnostic peaks. Three distinct sectors is the generator's
+    existing cross-column support floor. Contrast scale may differ: a coherent
+    inversion is unresolved continuity, not proof of a different material.
+    """
+    first_samples = {(s.start_x, s.stop_x): s.signed_contrast
+                     for s in first.evidence.native_path_polarities}
+    second_samples = {(s.start_x, s.stop_x): s.signed_contrast
+                      for s in second.evidence.native_path_polarities}
+    common = first_samples.keys() & second_samples.keys()
+    return len(common) >= 3 and all(first_samples[x] * second_samples[x] < 0 for x in common)
+
+
@@ -218,0 +235 @@ class DirectedInterfaceTrackletBuilder:
+        blocked_predecessors: dict[str, list[str]] = {}
@@ -273,0 +291 @@ class DirectedInterfaceTrackletBuilder:
+            blocked_tracks: set[str] = set()
@@ -283,0 +302,2 @@ class DirectedInterfaceTrackletBuilder:
