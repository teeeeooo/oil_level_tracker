/*
 * Calm three-role palette:
 *   neutral surfaces/text, blue interaction, red blocking feedback.
 */
QMainWindow {
    background: #f5f5f7;
    color: #1d1d1f;
}

QWidget {
    font-family: "Segoe UI", "Malgun Gothic", sans-serif;
    font-size: 10pt;
    color: #1d1d1f;
}

QToolBar#mainToolBar,
QToolBar#resultReviewToolBar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #d2d2d7;
    spacing: 3px;
    padding: 6px 10px;
}

QToolButton#toolbarButton,
QToolButton#toolbarMenuButton,
QToolButton#primaryToolButton {
    min-height: 30px;
    padding: 3px 10px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #1d1d1f;
    font-weight: 600;
}

QToolButton#toolbarButton:hover,
QToolButton#toolbarMenuButton:hover,
QToolButton#toolbarButton:pressed,
QToolButton#toolbarMenuButton:pressed,
QToolButton#toolbarButton:checked,
QToolButton#toolbarMenuButton:checked {
    background: #f0f0f2;
}

QToolButton#primaryToolButton {
    background: #007aff;
    color: #ffffff;
}

QToolButton#primaryToolButton:hover,
QToolButton#primaryToolButton:pressed {
    background: #0066d6;
}

QMenu {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    min-width: 190px;
    padding: 7px 18px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #eaf3ff;
    color: #005ecb;
}

QMenu::separator {
    height: 1px;
    margin: 5px 8px;
    background: #e5e5ea;
}

QToolButton:disabled,
QPushButton:disabled {
    background: #f0f0f2;
    color: #a1a1a6;
    border-color: #e5e5ea;
}

QLabel#stateBadge {
    margin-left: 8px;
    padding: 5px 9px;
    border-radius: 10px;
    background: #f0f0f2;
    color: #6e6e73;
    font-weight: 700;
}

QLabel#stateBadge[workbenchState="VALIDATED"],
QLabel#stateBadge[workbenchState="ANALYZED"],
QLabel#stateBadge[workbenchState="ANALYZING"] {
    background: #eaf3ff;
    color: #005ecb;
}

QLabel#stateBadge[workbenchState="ERROR"] {
    background: #fff0f1;
    color: #d70015;
}

QGroupBox {
    font-weight: 700;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    margin-top: 11px;
    padding: 9px 8px 8px 8px;
    background: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #1d1d1f;
}

QPushButton {
    min-height: 30px;
    padding: 3px 11px;
    border: 1px solid #d2d2d7;
    border-radius: 7px;
    background: #ffffff;
    color: #1d1d1f;
    font-weight: 600;
}

QPushButton:hover,
QPushButton:pressed,
QPushButton:checked {
    background: #eaf3ff;
    border-color: #007aff;
    color: #005ecb;
}

QPushButton#secondaryActionButton {
    background: #f5f5f7;
}

QPushButton#transportPrimaryButton,
QPushButton#primaryActionButton {
    min-width: 88px;
    background: #007aff;
    color: #ffffff;
    border-color: #007aff;
    font-weight: 700;
}

QPushButton#transportPrimaryButton:hover,
QPushButton#primaryActionButton:hover,
QPushButton#transportPrimaryButton:pressed,
QPushButton#primaryActionButton:pressed {
    background: #0066d6;
    border-color: #0066d6;
    color: #ffffff;
}

QLineEdit,
QDoubleSpinBox,
QSpinBox,
QComboBox,
QTextEdit,
QListWidget,
QTableWidget {
    min-height: 28px;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    background: #ffffff;
    selection-background-color: #007aff;
    selection-color: #ffffff;
}

QLineEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus,
QTextEdit:focus,
QListWidget:focus {
    border: 2px solid #007aff;
}

QListWidget::item {
    min-height: 30px;
    padding: 4px 6px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background: #eaf3ff;
    color: #005ecb;
}

QTabWidget::pane {
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    background: #ffffff;
}

QTabBar::tab {
    padding: 7px 10px;
    color: #6e6e73;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #005ecb;
    border-bottom-color: #007aff;
}

QWidget#glassListPanel,
QWidget#settingsPanel,
QWidget#resultReviewNavigation {
    background: #ffffff;
}

QWidget#workbenchCenterPanel,
QFrame#videoPlaybackPanel {
    background: #f5f5f7;
    border: none;
}

QLabel#sectionTitle {
    font-size: 11pt;
    font-weight: 800;
    color: #1d1d1f;
    padding: 4px 2px;
}

QLabel#videoPathLabel,
QLabel#metadataCard,
QLabel#resultReviewSummary {
    padding: 7px 9px;
    background: #f5f5f7;
    border: 1px solid #e5e5ea;
    border-radius: 7px;
    color: #3a3a3c;
}

QGroupBox#profileOwnershipGroup,
QGroupBox#currentTestOwnershipGroup {
    background: #ffffff;
    border-color: #d2d2d7;
}

QLabel#profileIdentityName,
QLabel#profileIdentityPath {
    font-weight: 700;
    color: #1d1d1f;
}

QLabel#profileAreaHeading {
    font-weight: 800;
    color: #1d1d1f;
}

QLabel#ownershipHint,
QLabel#previewHint,
QLabel#emptyPanelState,
QLabel#detectionSummaryRecommendation {
    color: #6e6e73;
    font-size: 9pt;
}

QLabel#emptyPanelState {
    padding: 24px;
}

QLabel#detectionSummaryInterpretation {
    font-weight: 700;
    color: #1d1d1f;
}

QWidget#transportBar {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 9px;
}

QLabel#timecodeLabel {
    min-width: 190px;
    color: #3a3a3c;
    font-family: "Consolas", "Malgun Gothic";
    font-weight: 600;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #d2d2d7;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #007aff;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #007aff;
    border: 2px solid #ffffff;
}

QSplitter::handle:horizontal,
QSplitter::handle:vertical {
    background: #e5e5ea;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background: #007aff;
}

QGraphicsView#videoCanvas {
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    background: #1d1d1f;
}

QDockWidget::title {
    background: #f0f0f2;
    padding: 6px;
    font-weight: 700;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e5e5ea;
    color: #6e6e73;
}

QWidget#guidedActionBar {
    background: #ffffff;
    border-top: 1px solid #d2d2d7;
}

QLabel#guidedStatusLabel {
    padding: 5px 9px;
    border-radius: 7px;
    background: #f0f0f2;
    color: #3a3a3c;
    font-weight: 700;
}

QLabel#guidedStatusLabel[validationState="error"] {
    background: #fff0f1;
    color: #d70015;
}

QLabel#guidedStatusLabel[validationState="warning"] {
    background: #f0f0f2;
    color: #3a3a3c;
}

QLabel#guidedStatusLabel[validationState="ready"] {
    background: #eaf3ff;
    color: #005ecb;
}

QToolButton#advancedToggle,
QToolButton#panelMenuButton {
    min-height: 28px;
    padding: 3px 8px;
    border: 1px solid #d2d2d7;
    border-radius: 7px;
    background: #f5f5f7;
    color: #3a3a3c;
    font-weight: 700;
}

QToolButton#advancedToggle:hover,
QToolButton#panelMenuButton:hover {
    background: #eaf3ff;
    border-color: #007aff;
    color: #005ecb;
}

QLabel#inlineValidationMessage {
    padding: 3px 5px;
    border-radius: 6px;
    font-size: 9pt;
}

QLabel#inlineValidationMessage[validationState="error"] {
    background: #fff0f1;
    color: #d70015;
}

QLabel#inlineValidationMessage[validationState="warning"] {
    background: #f0f0f2;
    color: #3a3a3c;
}

QDoubleSpinBox[interactionTarget="true"],
QSpinBox[interactionTarget="true"],
QListWidget[interactionTarget="true"],
QPushButton[interactionTarget="true"] {
    background: #eaf3ff;
}

QGroupBox[interactionTarget="true"] {
    border: 2px solid #007aff;
    background: #f7faff;
}

QLineEdit[validationState="error"],
QDoubleSpinBox[validationState="error"],
QSpinBox[validationState="error"],
QComboBox[validationState="error"],
QListWidget[validationState="error"],
QLabel#roiSummaryCard[validationState="error"] {
    border: 2px solid #d70015;
}

QLineEdit[validationState="warning"],
QDoubleSpinBox[validationState="warning"],
QSpinBox[validationState="warning"],
QComboBox[validationState="warning"],
QListWidget[validationState="warning"],
QLabel#roiSummaryCard[validationState="warning"] {
    border: 2px solid #86868b;
}

QLabel#roiEditorHint {
    padding: 7px 9px;
    border: 1px solid #d2d2d7;
    border-radius: 7px;
    background: #f5f5f7;
    color: #3a3a3c;
}

QWidget#workbenchProgress {
    background: #ffffff;
    border-bottom: 1px solid #d2d2d7;
}

QLabel#progressTitle {
    color: #1d1d1f;
    font-weight: 800;
}

QLabel#preflightProgressStatus,
QLabel#progressArrow {
    color: #86868b;
    font-weight: 600;
}

QPushButton#progressStepButton {
    min-width: 92px;
    min-height: 32px;
    padding: 3px 7px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: #6e6e73;
    font-weight: 700;
}

QPushButton#progressStepButton[stepState="complete"] {
    background: #f0f0f2;
    color: #3a3a3c;
}

QPushButton#progressStepButton[stepState="current"] {
    background: #eaf3ff;
    border-color: #007aff;
    color: #005ecb;
}

QPushButton#progressStepButton[stepState="error"] {
    background: #fff0f1;
    border-color: #d70015;
    color: #d70015;
}

QPushButton#progressStepButton[stepState="warning"] {
    background: #f0f0f2;
    color: #3a3a3c;
}

QPushButton#nextIssueButton {
    padding: 3px 9px;
    font-weight: 700;
}

QGroupBox#detectionSummaryCard {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
}

QGroupBox#detectionSummaryCard[quality="normal"] {
    border: 2px solid #007aff;
}

QGroupBox#detectionSummaryCard[quality="review"] {
    border: 2px solid #86868b;
}

QGroupBox#detectionSummaryCard[quality="failure"] {
    border: 2px solid #d70015;
}

QLabel#detectionSummaryHeading {
    color: #86868b;
    font-size: 9pt;
    font-weight: 600;
}
